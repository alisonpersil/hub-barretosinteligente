{
  "version": 2,
  "buildCommand": "python scripts/vercel_build.py --vercel",
  "build": {
    "env": {
      "VERCEL_SUPPORT_LARGE_FUNCTIONS": "1"
    }
  },
  "env": {
    "VERCEL_SUPPORT_LARGE_FUNCTIONS": "1"
  },
  "functions": {
    "api/index.py": {
      "excludeFiles": "{**/*.pdf,**/*.PDF,**/*.xls,**/*.xlsx,**/*.pkl,*.pdf,*.PDF,*.xls,*.xlsx,*.pkl}"
    },
    "api/**/*.py": {
      "excludeFiles": "{**/*.pdf,**/*.PDF,**/*.xls,**/*.xlsx,**/*.pkl,*.pdf,*.PDF,*.xls,*.xlsx,*.pkl}"
    }
  },
  "headers": [
    {
      "source": "/exati/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/exati",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
